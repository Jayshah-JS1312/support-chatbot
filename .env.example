# Model provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1
MODEL=gpt-4o-mini

# HTTP application
SUPPORT_CHATBOT_HOST=127.0.0.1
SUPPORT_CHATBOT_PORT=8000
SUPPORT_CHATBOT_MAX_REQUEST_BYTES=65536
SUPPORT_CHATBOT_SECURE_COOKIES=false
SUPPORT_CHATBOT_EXPOSE_INTERNAL_UI=false
SUPPORT_CHATBOT_AUTH_SESSION_HOURS=24
SUPPORT_CHATBOT_EXPOSE_RESET_TOKEN=false
SUPPORT_CHATBOT_PUBLIC_BASE_URL=http://localhost:8000
SUPPORT_CHATBOT_WORKFLOW_RETRIES=3
SUPPORT_CHATBOT_WORKFLOW_LEASE_SECONDS=300
SUPPORT_CHATBOT_APPROVAL_TTL_HOURS=24
# Required in deployed environments to enable durable Upstash delivery.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# PostgreSQL / Supabase. Use the Session pooler URL on IPv4-only hosts.
# Production Supabase connections must include sslmode=require (or verify-full).
DATABASE_URL=postgresql://support_chatbot:support_chatbot@127.0.0.1:5432/support_chatbot
SUPPORT_CHATBOT_DB_POOL_MIN=1
SUPPORT_CHATBOT_DB_POOL_MAX=5

# Optional persistent locations (container defaults are /data/state and /data/cache)
# SUPPORT_CHATBOT_STATE_DIR=/absolute/path/to/state
# SUPPORT_CHATBOT_CACHE_DIR=/absolute/path/to/cache
