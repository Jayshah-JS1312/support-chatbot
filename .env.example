# Model provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1
MODEL=gpt-4o-mini

# HTTP application
SUPPORT_CHATBOT_HOST=127.0.0.1
SUPPORT_CHATBOT_PORT=8000
SUPPORT_CHATBOT_MAX_REQUEST_BYTES=65536
SUPPORT_CHATBOT_SECURE_COOKIES=false
SUPPORT_CHATBOT_EXPOSE_INTERNAL_UI=false

# Optional persistent locations (container defaults are /data/state and /data/cache)
# SUPPORT_CHATBOT_STATE_DIR=/absolute/path/to/state
# SUPPORT_CHATBOT_CACHE_DIR=/absolute/path/to/cache
